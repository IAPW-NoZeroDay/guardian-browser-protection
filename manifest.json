{
  "manifest_version": 3,
  "name": "Guardian Browser Protection",
  "version": "1.3.0",
  "description": "Browser protection against fake Microsoft 365 sign-in pages. Modified build of Check by CyberDrain (AGPL-3.0); source: https://github.com/IAPW-NoZeroDay/guardian-browser-protection",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "webRequest",
    "alarms",
    "identity",
    "identity.email"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*/*"],
      "js": ["scripts/browser-polyfill-inline.js", "scripts/content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Guardian Browser Protection",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "config/*",
        "rules/*",
        "images/*",
        "blocked.html",
        "scripts/utils/logger.js",
        "scripts/blocked.js",
        "scripts/source-report.js",
        "scripts/browser-polyfill.js",
        "scripts/browser-polyfill-inline.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;"
  },
  "storage": {
    "managed_schema": "config/managed_schema.json"
  }
}
